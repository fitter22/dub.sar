# DUB.SAR 1.0 — Tablet YBC 7289: The Diagonal of the Square
# Calculates the Babylonian approximation of sqrt(2): 1;24,51,10

problem

    initial-estimate : 1;30
    steps : 3
    target-diagonal : 30

    approx :
        initial-estimate
        steps
        apply babylonian-sqrt

    diagonal :
        target-diagonal
        approx
        multiply

recipe babylonian-sqrt start iterations:

    x : start
    two : 2
    half : 0;30

    consider step from 1 through iterations:
        next-x :
            x
            two
            x
            divide
            add
            half
            multiply
        x : next-x

    determine x

result

    output "Babylonian sqrt(2) approximation:"
    output approx

    output "Square with side 30 has diagonal:"
    output diagonal
