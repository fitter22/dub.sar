# DUB.SAR 1.0 Example: Full Conformance Test Suite
# Difficulty: Exemplar
# Concept: Language & Specification Verification
# Mode: Scholar (Latin transliteration)
#
# Purpose:
#   Directly verifies comprehensive mathematical and runtime conformance:
#   numbers, sexagesimal arithmetic, unit safety, exact equality, and bounded loops.
#
# Expected Output:
#   sum 1;30 + 0;30 (expected 2):
#   2
#   mul 2 * 0;30 (expected 1):
#   1
#   div 3 / 2 (expected 1;30):
#   1;30
#   unit sum 1 day + 2 day (expected 3 day):
#   3 day
#   exactness checks:
#   1
#   1
#   bounded repetition 1..5 sum (expected 15):
#   15

problem

    # Numbers
    n1 : 1
    n60 : 60
    n-one : 1;0
    n-one-half : 1;30
    solar : 365;14,31,55

    # Arithmetic
    sum-res :
        1;30
        0;30
        add

    mul-res :
        2
        0;30
        multiply

    div-res :
        3
        2
        divide

    # Unit safety
    d1 : 1 day
    d2 : 2 day
    d-total :
        d1
        d2
        add

    # Exactness check: 1;0 == 1, 1;30 == 3/2
    exact-check-1 :
        1;0
        1
        equal

    exact-check-2 :
        1;30
        3
        2
        divide
        equal

    # Repetition check
    acc : 0
    consider i from 1 through 5:
        next-acc :
            acc
            i
            add
        acc : next-acc

result

    output "sum 1;30 + 0;30 (expected 2):"
    output sum-res

    output "mul 2 * 0;30 (expected 1):"
    output mul-res

    output "div 3 / 2 (expected 1;30):"
    output div-res

    output "unit sum 1 day + 2 day (expected 3 day):"
    output d-total

    output "exactness checks:"
    output exact-check-1
    output exact-check-2

    output "bounded repetition 1..5 sum (expected 15):"
    output acc
