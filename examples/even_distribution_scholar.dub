# DUB.SAR 1.0 Example: Even Distribution of Leap Years
# Difficulty: Exemplar
# Concept: Bresenham Intercalation Distribution
# Mode: Scholar (Latin transliteration)
#
# Purpose:
#   Distributes leap days uniformly across calendar cycles using exact
#   integer Bresenham accumulator arithmetic.
#
# Expected Output:
#   year 1 extra day:
#   0
#   year 2 extra day:
#   0
#   year 3 extra day:
#   0
#   year 4 extra day:
#   1

problem

    cycle : 4
    leaps : 1

    y1 :
        1
        cycle
        leaps
        apply leap-for-year

    y2 :
        2
        cycle
        leaps
        apply leap-for-year

    y3 :
        3
        cycle
        leaps
        apply leap-for-year

    y4 :
        4
        cycle
        leaps
        apply leap-for-year

recipe leap-for-year year cycle leaps:

    prev-year :
        year
        1
        -

    cur-count :
        year
        leaps
        *
        cycle
        /
        floor

    prev-count :
        prev-year
        leaps
        *
        cycle
        /
        floor

    is-leap :
        cur-count
        prev-count
        -

    determine is-leap

result

    output "year 1 extra day:"
    output y1

    output "year 2 extra day:"
    output y2

    output "year 3 extra day:"
    output y3

    output "year 4 extra day:"
    output y4
