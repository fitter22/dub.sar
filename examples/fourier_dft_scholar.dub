# DUB.SAR 1.0 Example: Discrete Fourier Transform
# Difficulty: Mastery
# Concept: Discrete Fourier Transform & Radix-2 FFT
# Mode: Scholar (Latin transliteration)
#
# Purpose:
#   Computes Discrete Fourier Transforms on sequence tablets, verifying
#   energy conservation and inverse reconstruction.
#
# Expected Output:
#   2
#   4
#   4
#   1
#   1
#   1

problem
    # 1. Consult the Powers of Two table to verify sequence length is a harmonic power of 2
    len_check : take "len-4" from "powers-of-two"

    # 2. Construct an input sequence tablet of discrete signal samples
    working sig of length 0
    sig 1 append
    sig 0 append
    sig 0 append
    sig 0 append

    # 3. Compute the Discrete Fourier Transform (reference DFT)
    fwd_dft : sig dft
    dft_len : fwd_dft length

    # 4. Compute the Fast Fourier Transform (Radix-2 FFT)
    fwd_fft : sig fft
    fft_len : fwd_fft length

    # 5. Extract first harmonic bin magnitude from both transforms
    bin0_dft : fwd_dft 0 take
    bin0_fft : fwd_fft 0 take
    mag_dft : bin0_dft.magnitude
    mag_fft : bin0_fft.magnitude

    # 6. Reconstruct the original signal using inverse DFT
    recon : fwd_dft inverse-dft
    first_recon : recon 0 take
    orig_val : first_recon.magnitude

result
    len_check
    dft_len
    fft_len
    mag_dft
    mag_fft
    orig_val
