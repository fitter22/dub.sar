# DUB.SAR 1.0 — Planetary Leap-Year Rule (Scholar Mode)
# As specified in Section 72 of DUB.SAR 1.0 Redesign

problem

    solar-year : ask "solar year in days"
    limit : 1000

    whole-days :
        solar-year
        floor

    fraction :
        solar-year
        whole-days
        subtract

    best : empty

    consider cycle from 1 through limit:

        leaps :
            cycle
            fraction
            multiply
            nearest

        error :
            whole-days
            leaps
            cycle
            divide
            add
            solar-year
            subtract
            absolute

        candidate :
            cycle
            leaps
            error

        retain candidate when error is lesser than best.error

result

    best
