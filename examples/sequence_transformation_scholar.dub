# DUB.SAR 1.0 — Sequence Transformation (Scholar Mode)
# Demonstrates iterating entries of a tablet and constructing a transformed sequence.

problem:

    working raw_values of length 0
    append 12 to raw_values
    append 24 to raw_values
    append 36 to raw_values
    append 48 to raw_values

    working doubled of length 0
    total : 0

    consider entries of raw_values:
        append v * 2 to doubled
        total : total + v

    doubled_len : length of doubled
    final_entry : last from doubled

result:

    total
    doubled_len
    final_entry
