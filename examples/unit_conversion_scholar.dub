# DUB.SAR 1.0 Example: Unit Conversions and Dimensional Safety
# Difficulty: Beginner
# Concept: Units & Dimensional Metrology
# Mode: Scholar (Latin transliteration)
#
# Purpose:
#   Demonstrates physical unit conversions and compile-time dimensional safety
#   across standard metrological dimensions (time, length, mass).
#
# Expected Output:
#   7200 seconds converted to hours (expected 2 hour):
#   2 hour
#   36 hours converted to days (expected 1;30 day):
#   1;30 day
#   1;30 day converted to minutes (expected 2160 minute):
#   2160 minute
#   36 hour + 12 hour:
#   48 hour

problem

    # Base quantities
    t-sec : 7200 second
    t-min : 180 minute
    t-hr : 36 hour

    # Explicit conversions
    c-hr :
        t-sec
        hour
        apply convert

    c-day :
        t-hr
        day
        apply convert

    c-min :
        c-day
        minute
        apply convert

    # Compatible addition
    total-time :
        t-hr
        12 hour
        add

result

    output "7200 seconds converted to hours (expected 2 hour):"
    output c-hr

    output "36 hours converted to days (expected 1;30 day):"
    output c-day

    output "1;30 day converted to minutes (expected 2160 minute):"
    output c-min

    output "36 hour + 12 hour:"
    output total-time
